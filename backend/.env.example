# Database Connection
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/jigo_db?schema=public"

# Auth secrets
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="7d"

# Server environment configuration
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# Stripe (optional - mock mode used when empty)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (SMTP)
ENABLE_EMAILS="false"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@jigo.app"
