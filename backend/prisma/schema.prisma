generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  name            String    @db.VarChar(100)
  role            Role      @default(customer)
  phone           String?   @db.VarChar(20)
  profilePhoto    String?   @map("profile_photo") @db.VarChar(255)
  location        String?   @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  isVerified      Boolean   @default(false) @map("is_verified")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  passwordResetToken String? @unique @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires DateTime? @map("password_reset_expires")

  profile         Profile?
  bookingsAsCustomer Booking[] @relation("customerBookings")
  bookingsAsJigolo  Booking[] @relation("jigoloBookings")
  sentMessages    Message[] @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")
  reviewsGiven    Review[]  @relation("reviewsGiven")
  reviewsReceived Review[]  @relation("reviewsReceived")
  favorites       Favorite[]
  notifications   Notification[]
  matchingPreference MatchingPreference?
  recommendedMatches RecommendedMatch[]
  promotionUsage  PromotionUsage[]
  loyaltyPoint    LoyaltyPoint?
  loyaltyTransactions LoyaltyTransaction[]
  referralCodes   ReferralCode[]
  referralsMade   Referral[]  @relation("referralsMade")
  referralsReceived Referral[] @relation("referralsReceived")
  disputesRaised  Dispute[]   @relation("disputesRaised")
  disputesAgainst Dispute[]   @relation("disputesAgainst")
  disputeMessages DisputeMessage[]
  disputeEvidence DisputeEvidence[]
  disputeActions  DisputeAction[]
  activities      UserActivityLog[]
  jigoloFeePreference JigoloFeePreference?
  feeTransactionsAsJigolo FeeTransaction[] @relation("jigoloFeeTransactions")
  feeTransactionsAsCustomer FeeTransaction[] @relation("customerFeeTransactions")
  subscriptions    UserSubscription[]
  userEmbedding    UserEmbedding?
  jigoloEmbedding  JigoloEmbedding?
  matchingFeedback MatchingFeedback[]
  experimentData   ExperimentData[]
  feeDisputesRaised FeeDispute[] @relation("feeDisputesRaised")
  feeDisputesResolved FeeDispute[] @relation("feeDisputesResolved")
  feeHistoryChanges FeeHistory[]
  helpfulVotes    ReviewHelpful[] @relation("helpfulVotes")

  @@map("users")
}

model Profile {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  bio           String?   @db.Text
  age           Int?
  gender        String?   @db.VarChar(20)
  tags          String[]  @default([])
  specialties   String[]  @default([])
  languages     String[]  @default([])
  pricePerHour  Decimal?  @map("price_per_hour") @db.Decimal(10,2)
  rating        Decimal   @default(0) @db.Decimal(3,2)
  reviewsCount  Int       @default(0) @map("reviews_count")
  verified      Boolean   @default(false)
  joinDate      DateTime  @default(now()) @map("join_date") @db.Date
  availability  Json?     @db.JsonB
  services      Json?     @db.JsonB
  images        String[]  @default([])
  totalEarnings Decimal?  @map("total_earnings") @db.Decimal(12,2)
  totalBookings Int       @default(0) @map("total_bookings")
  profileViews  Int       @default(0) @map("profile_views")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  favorites     Favorite[]
  matchingScores MatchingScore[]
  matchingFeedback MatchingFeedback[]

  @@map("profiles")
}

model Booking {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  jigoloId        String    @map("jigolo_id") @db.Uuid
  profileId       String    @map("profile_id") @db.Uuid
  date            DateTime  @db.Date
  startTime       String    @map("start_time") @db.VarChar(20)
  endTime         String    @map("end_time") @db.VarChar(20)
  package         String?   @db.VarChar(50)
  totalPrice      Decimal   @map("total_price") @db.Decimal(10,2)
  status          BookingStatus @default(pending)
  specialRequests String?   @map("special_requests") @db.Text
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  bookingNumber   String?   @map("booking_number") @db.VarChar(20)
  cancelledAt     DateTime? @map("cancelled_at")
  cancellationReason String? @map("cancellation_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  customer        User      @relation("customerBookings", fields: [customerId], references: [id])
  jigolo          User      @relation("jigoloBookings", fields: [jigoloId], references: [id])
  profile         Profile   @relation(fields: [profileId], references: [id])
  reviews         Review[]
  disputes        Dispute[]
  feeTransaction  FeeTransaction?
  feeCalculations FeeCalculation[]

  @@map("bookings")
}

model Review {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  reviewerId  String   @map("reviewer_id") @db.Uuid
  jigoloId    String   @map("jigolo_id") @db.Uuid
  rating      Int
  comment     String?  @db.Text
  response    String?  @db.Text
  responseAt  DateTime? @map("response_at")
  isPublic    Boolean  @default(true) @map("is_public")
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  helpfulCount Int     @default(0) @map("helpful_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer    User            @relation("reviewsGiven", fields: [reviewerId], references: [id])
  jigolo      User            @relation("reviewsReceived", fields: [jigoloId], references: [id])
  helpfulVotes ReviewHelpful[] @relation("reviewHelpfulVotes")

  @@unique([bookingId, reviewerId])
  @@map("reviews")
}

model ReviewHelpful {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  review    Review   @relation("reviewHelpfulVotes", fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation("helpfulVotes", fields: [userId], references: [id])

  @@unique([reviewId, userId])
  @@map("review_helpful")
}

model Message {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  receiverId  String    @map("receiver_id") @db.Uuid
  content     String    @db.Text
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  sender      User      @relation("sentMessages", fields: [senderId], references: [id])
  receiver    User      @relation("receivedMessages", fields: [receiverId], references: [id])

  @@map("messages")
}

model Favorite {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@map("favorites")
}

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(255)
  message     String    @db.Text
  type        String    @db.VarChar(50)
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  link        String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model MatchingPreference {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  preferredGenders String[] @map("preferred_genders")
  ageRangeMin      Int?     @map("age_range_min")
  ageRangeMax      Int?     @map("age_range_max")
  preferredLanguages String[] @map("preferred_languages")
  preferredTags    String[] @map("preferred_tags")
  budgetMin        Decimal? @map("budget_min") @db.Decimal(10,2)
  budgetMax        Decimal? @map("budget_max") @db.Decimal(10,2)
  locationRadius   Int      @default(50) @map("location_radius")
  availabilityPrefs Json?   @map("availability_preferences") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("matching_preferences")
}

model MatchingScore {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  profileId         String   @map("profile_id") @db.Uuid
  score             Decimal  @db.Decimal(5,2)
  skillsScore       Decimal? @map("skills_score") @db.Decimal(5,2)
  locationScore     Decimal? @map("location_score") @db.Decimal(5,2)
  priceScore        Decimal? @map("price_score") @db.Decimal(5,2)
  demographicScore  Decimal? @map("demographic_score") @db.Decimal(5,2)
  availabilityScore Decimal? @map("availability_score") @db.Decimal(5,2)
  languageScore     Decimal? @map("language_score") @db.Decimal(5,2)
  reputationScore   Decimal? @map("reputation_score") @db.Decimal(5,2)
  confidence        Decimal? @db.Decimal(5,2)
  factors           Json?
  lastCalculated    DateTime @default(now()) @map("last_calculated")
  createdAt         DateTime @default(now()) @map("created_at")

  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@map("matching_scores")
}

model RecommendedMatch {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  matchScore  Decimal   @map("match_score") @db.Decimal(5,2)
  reason      String?   @db.Text
  isDismissed Boolean   @default(false) @map("is_dismissed")
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@map("recommended_matches")
}

model UserEmbedding {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  embedding     Float[]  @map("embedding")
  modelVersion  String   @map("model_version") @db.VarChar(50)
  lastComputed  DateTime @default(now()) @map("last_computed")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_embeddings")
}

model JigoloEmbedding {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jigoloId      String   @unique @map("jigolo_id") @db.Uuid
  embedding     Float[]  @map("embedding")
  modelVersion  String   @map("model_version") @db.VarChar(50)
  lastComputed  DateTime @default(now()) @map("last_computed")
  createdAt     DateTime @default(now()) @map("created_at")

  jigolo        User     @relation(fields: [jigoloId], references: [id], onDelete: Cascade)

  @@map("jigolo_embeddings")
}

model SkillsGraph {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillName         String   @unique @map("skill_name") @db.VarChar(100)
  clusterId         String?  @map("cluster_id") @db.Uuid
  coOccurringSkills Json?    @map("co_occurring_skills") @db.JsonB
  frequency         Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("skills_graph")
}

model SkillCluster {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clusterName       String   @map("cluster_name") @db.VarChar(100)
  skills            String[] @map("skills")
  clusterCentrality Decimal? @map("cluster_centrality") @db.Decimal(5,2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("skill_clusters")
}

model MatchingFeedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  action    String   @db.VarChar(20)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("matching_feedback")
}

model ExperimentData {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  variant   String   @db.VarChar(20)
  metrics   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("experiment_data")
}

model Promotion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String    @unique @db.VarChar(50)
  type              String    @db.VarChar(50)
  value             Decimal   @db.Decimal(10,2)
  description       String?   @db.Text
  startDate         DateTime  @map("start_date")
  endDate           DateTime  @map("end_date")
  usageLimit        Int       @default(0) @map("usage_limit")
  usageCount        Int       @default(0) @map("usage_count")
  userLimitPerPerson Int      @default(1) @map("user_limit_per_person")
  minBookingValue   Decimal   @default(0) @map("min_booking_value") @db.Decimal(10,2)
  maxDiscount       Decimal?  @map("max_discount") @db.Decimal(10,2)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  usageRecords      PromotionUsage[]

  @@map("promotions")
}

model PromotionUsage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId    String   @map("promotion_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  bookingNumber  String   @map("booking_number") @db.VarChar(20)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10,2)
  usedAt         DateTime @default(now()) @map("used_at")

  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id])

  @@map("promotion_usage")
}

model LoyaltyPoint {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  points        Int      @default(0)
  totalEarned   Int      @default(0) @map("total_earned")
  totalRedeemed Int      @default(0) @map("total_redeemed")
  tier          String   @default("bronze") @db.VarChar(20)
  lastActivityAt DateTime? @map("last_activity_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("loyalty_points")
}

model LoyaltyTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  points      Int
  type        String   @db.VarChar(20)
  source      String   @db.VarChar(50)
  referenceId String?  @map("reference_id") @db.Uuid
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id])

  @@map("loyalty_transactions")
}

model ReferralCode {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  code       String   @unique @db.VarChar(50)
  usageCount Int      @default(0) @map("usage_count")
  maxUses    Int      @default(10) @map("max_uses")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals  Referral[]

  @@map("referral_codes")
}

model Referral {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId     String   @map("referrer_id") @db.Uuid
  refereeId      String   @map("referee_id") @db.Uuid
  referralCodeId String   @map("referral_code_id") @db.Uuid
  status         String   @default("pending") @db.VarChar(20)
  rewardEarned   Decimal  @default(0) @map("reward_earned") @db.Decimal(10,2)
  rewardClaimed  Boolean  @default(false) @map("reward_claimed")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  referrer       User     @relation("referralsMade", fields: [referrerId], references: [id])
  referee        User     @relation("referralsReceived", fields: [refereeId], references: [id])
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id])

  @@unique([referrerId, refereeId])
  @@map("referrals")
}

model Dispute {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String   @map("booking_id") @db.Uuid
  raisedById      String   @map("raised_by") @db.Uuid
  raisedAgainstId String   @map("raised_against") @db.Uuid
  type            String   @db.VarChar(50)
  reason          String   @db.VarChar(255)
  description     String?  @db.Text
  status          String   @default("pending") @db.VarChar(20)
  priority        String   @default("medium") @db.VarChar(20)
  assignedTo      String?  @map("assigned_to") @db.Uuid
  resolvedBy      String?  @map("resolved_by") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at")
  resolutionNotes String?  @map("resolution_notes") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedBy        User     @relation("disputesRaised", fields: [raisedById], references: [id])
  raisedAgainst   User     @relation("disputesAgainst", fields: [raisedAgainstId], references: [id])
  messages        DisputeMessage[]
  evidence        DisputeEvidence[]
  actions         DisputeAction[]

  @@map("disputes")
}

model DisputeMessage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disputeId     String   @map("dispute_id") @db.Uuid
  senderId      String   @map("sender_id") @db.Uuid
  message       String   @db.Text
  attachmentUrls String[] @map("attachment_urls")
  isInternal    Boolean  @default(false) @map("is_internal")
  createdAt     DateTime @default(now()) @map("created_at")

  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender        User     @relation(fields: [senderId], references: [id])

  @@map("dispute_messages")
}

model DisputeEvidence {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disputeId     String   @map("dispute_id") @db.Uuid
  evidenceType  String   @map("evidence_type") @db.VarChar(50)
  evidenceUrl   String   @map("evidence_url") @db.VarChar(500)
  description   String?  @db.Text
  uploadedBy    String?  @map("uploaded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploader      User?    @relation(fields: [uploadedBy], references: [id])

  @@map("dispute_evidence")
}

model DisputeAction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disputeId   String   @map("dispute_id") @db.Uuid
  actionType  String   @map("action_type") @db.VarChar(50)
  note        String?  @db.Text
  performedBy String?  @map("performed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  performer   User?    @relation(fields: [performedBy], references: [id])

  @@map("dispute_actions")
}

model DailyAnalytic {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date               DateTime @unique @db.Date
  totalUsers         Int      @default(0) @map("total_users")
  newUsers           Int      @default(0) @map("new_users")
  activeUsers        Int      @default(0) @map("active_users")
  totalBookings      Int      @default(0) @map("total_bookings")
  completedBookings  Int      @default(0) @map("completed_bookings")
  cancelledBookings  Int      @default(0) @map("cancelled_bookings")
  totalRevenue       Decimal  @default(0) @map("total_revenue") @db.Decimal(12,2)
  platformFees       Decimal  @default(0) @map("platform_fees") @db.Decimal(12,2)
  totalPayouts       Decimal  @default(0) @map("total_payouts") @db.Decimal(12,2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("daily_analytics")
}

model UserActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  category  String   @db.VarChar(50)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("user_activity_logs")
}

model PlatformMetric {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metricName  String   @map("metric_name") @db.VarChar(100)
  metricValue Json?    @map("metric_value") @db.JsonB
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@map("platform_metrics")
}

model Report {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  type        String   @db.VarChar(50)
  data        Json?
  generatedAt DateTime @default(now()) @map("generated_at")
  createdBy   String?  @map("created_by") @db.Uuid

  @@map("reports")
}

enum Role {
  customer
  jigolo
  admin
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
}

model FeeConfiguration {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String    @unique @db.VarChar(100)
  value         Decimal   @db.Decimal(12,4)
  description   String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("fee_configurations")
}

model JigoloFeePreference {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jigoloId             String   @unique @map("jigolo_id") @db.Uuid
  customRate           Decimal? @map("custom_rate") @db.Decimal(5,2)
  feeCap               Decimal? @map("fee_cap") @db.Decimal(12,2)
  preferredPayoutMethod String? @map("preferred_payout_method") @db.VarChar(50)
  autoDeduct           Boolean  @default(true) @map("auto_deduct")
  payoutSchedule       String   @default("standard") @map("payout_schedule") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  jigolo               User     @relation(fields: [jigoloId], references: [id], onDelete: Cascade)

  @@map("jigolo_fee_preferences")
}

model FeeTransaction {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId          String    @unique @map("booking_id") @db.Uuid
  jigoloId           String    @map("jigolo_id") @db.Uuid
  customerId         String    @map("customer_id") @db.Uuid
  platformFee        Decimal   @map("platform_fee") @db.Decimal(12,2)
  jigoloFee          Decimal   @map("jigolo_fee") @db.Decimal(12,2)
  transactionFee     Decimal   @default(0) @map("transaction_fee") @db.Decimal(12,2)
  cancellationFee    Decimal   @default(0) @map("cancellation_fee") @db.Decimal(12,2)
  subscriptionDiscount Decimal @default(0) @map("subscription_discount") @db.Decimal(12,2)
  totalFee           Decimal   @map("total_fee") @db.Decimal(12,2)
  netAmount          Decimal   @map("net_amount") @db.Decimal(12,2)
  bookingAmount      Decimal   @map("booking_amount") @db.Decimal(12,2)
  currency           String    @default("USD") @db.VarChar(10)
  status             String    @default("pending") @db.VarChar(20)
  calculatedAt       DateTime  @default(now()) @map("calculated_at")
  settledAt          DateTime? @map("settled_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  jigolo             User      @relation("jigoloFeeTransactions", fields: [jigoloId], references: [id])
  customer           User      @relation("customerFeeTransactions", fields: [customerId], references: [id])
  feeDisputes        FeeDispute[]

  @@map("fee_transactions")
}

model SubscriptionPlan {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String   @db.VarChar(100)
  code               String   @unique @db.VarChar(50)
  description        String?  @db.Text
  price              Decimal  @db.Decimal(10,2)
  duration           Int      @map("duration_days")
  features           Json?
  feeDiscountPercent Decimal  @default(0) @map("fee_discount_percent") @db.Decimal(5,2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  subscriptions      UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  startDate   DateTime @default(now()) @map("start_date")
  endDate     DateTime @map("end_date")
  autoRenew   Boolean  @default(false) @map("auto_renew")
  status      String   @default("active") @db.VarChar(20)
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])

  @@unique([userId, planId])
  @@map("user_subscriptions")
}

model FeeCalculation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String   @map("booking_id") @db.Uuid
  baseAmount       Decimal  @map("base_amount") @db.Decimal(12,2)
  platformRate     Decimal  @map("platform_rate") @db.Decimal(5,2)
  jigoloRate       Decimal  @map("jigolo_rate") @db.Decimal(5,2)
  transactionRate  Decimal  @default(0) @map("transaction_rate") @db.Decimal(5,2)
  platformFee      Decimal  @map("platform_fee") @db.Decimal(12,2)
  jigoloFee        Decimal  @map("jigolo_fee") @db.Decimal(12,2)
  transactionFee   Decimal  @default(0) @map("transaction_fee") @db.Decimal(12,2)
  cancellationFee  Decimal  @default(0) @map("cancellation_fee") @db.Decimal(12,2)
  discountAmount   Decimal  @default(0) @map("discount_amount") @db.Decimal(12,2)
  discountType     String?  @map("discount_type") @db.VarChar(50)
  totalFee         Decimal  @map("total_fee") @db.Decimal(12,2)
  netAmount        Decimal  @map("net_amount") @db.Decimal(12,2)
  breakdown        Json?    @db.JsonB
  calculatedAt     DateTime @default(now()) @map("calculated_at")

  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("fee_calculations")
}

model FeeDispute {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeTransactionId String  @map("fee_transaction_id") @db.Uuid
  raisedById      String   @map("raised_by") @db.Uuid
  reason          String   @db.VarChar(255)
  description     String?  @db.Text
  status          String   @default("pending") @db.VarChar(20)
  resolvedBy      String?  @map("resolved_by") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at")
  resolutionNotes String?  @map("resolution_notes") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  feeTransaction  FeeTransaction @relation(fields: [feeTransactionId], references: [id], onDelete: Cascade)
  raisedBy        User     @relation("feeDisputesRaised", fields: [raisedById], references: [id])
  resolvedByUser  User?    @relation("feeDisputesResolved", fields: [resolvedBy], references: [id])

  @@map("fee_disputes")
}

model FeeHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  fieldName   String   @map("field_name") @db.VarChar(100)
  oldValue    String?  @map("old_value") @db.Text
  newValue    String?  @map("new_value") @db.Text
  changedBy   String?  @map("changed_by") @db.Uuid
  reason      String?  @db.Text
  changedAt   DateTime @default(now()) @map("changed_at")

  changedByUser User?  @relation(fields: [changedBy], references: [id])

  @@map("fee_history")
}
